# SOC-Tesis — Honey-Server .env.example
#
# Copiar a `.env` (ignorado por git) antes de `docker compose up`. Ninguno de
# estos valores es secreto: son referencias de imagen fijadas por digest
# (D2, CLOSED — `.knowledge/17_SOFTWARE_BASELINE.md` §2). El digest manda;
# el tag es solo legibilidad.
#
# Política de imágenes (ADR-002): oficial cuando existe; `dtagdevsec/*:24.04.1`
# (T-Pot CE) SOLO para Snare/Tanner/Redis/phpox, que no tienen imagen oficial.
# No usar `latest` en ningún valor.

COWRIE_IMAGE=cowrie/cowrie:3.1.1@sha256:710f1e4601a663ac8591f58a42b44e4cd3b7ea170c7e6cdb9e54c430a30cd459
DIONAEA_IMAGE=dinotools/dionaea:nightly@sha256:7371e8eeb91fa2d0752f547006b66da962a9ebdb6a3e1ca7ae92e2cff24aad8a
MAILONEY_IMAGE=ghcr.io/phin3has/mailoney:sha-b8310a7@sha256:7fe3e29cb000ee0ce3158c653a5c08a51b1a821c6302027661184eb4ec368f4e
SNARE_IMAGE=dtagdevsec/snare:24.04.1@sha256:826f7a077b2e9cfa8647b21c4f6adc0bc47ecba2799dd88eb698104416268611
TANNER_IMAGE=dtagdevsec/tanner:24.04.1@sha256:eb971d4f208e99726cd0f5b00fc3500bc8e1e7a37c2929b84da544ed8ae5ee55
TANNER_REDIS_IMAGE=dtagdevsec/redis:24.04.1@sha256:45ea38a8c893d40922f2a4e969cc618213216e685f059a0c24cba7c983aa6345
TANNER_PHPOX_IMAGE=dtagdevsec/phpox:24.04.1@sha256:ba11d1b05e856602508c0fc8b197aa792f2f865c2f08740c49e843e1516e5894

# Rutas del host (Honey-Server) donde el Wazuh Agent lee los eventos JSON de
# cada honeypot (D4). Deben existir y ser legibles por el agente ANTES de
# `docker compose up` — ver README de arranque. En el laptop/local no
# existen por defecto: para pruebas locales, sobrescribir con una ruta bajo
# el repo (p. ej. ./evidence/local-tests/<fecha>/bind-mounts/cowrie/log).
SOC_TESIS_COWRIE_LOG_DIR=/srv/soc-tesis/cowrie/log
SOC_TESIS_DIONAEA_LIB_DIR=/srv/soc-tesis/dionaea/lib
SOC_TESIS_TANNER_LOG_DIR=/srv/soc-tesis/tanner/log
